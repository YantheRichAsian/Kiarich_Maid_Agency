---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../lib/site';
---

<BaseLayout title="Contact Us">
  <PageHero titleKey="contactPage.hero" subtitleKey="contactPage.heroSubtitle" />

  <section class="section-pad bg-warm-50">
    <div class="container-page grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="card-soft p-8 sm:p-10" data-reveal="slide-left">
        <h2 data-i18n="contactPage.formTitle" class="text-2xl font-semibold"></h2>
        <p data-i18n="contactPage.formIntro" class="mt-2 text-sm text-charcoal-soft"></p>

        <form id="kiarich-enquiry-form" class="mt-8 grid gap-5" name="kiarich-enquiry" data-whatsapp-conversion>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label data-i18n="contactPage.nameLabel" class="mb-1.5 block text-sm font-medium"></label>
              <input type="text" name="name" id="enquiry-name" required class="w-full rounded-lg border border-line bg-white px-4 py-3 text-sm focus:border-brand-red focus:outline-none" />
            </div>
            <div>
              <label data-i18n="contactPage.phoneLabel" class="mb-1.5 block text-sm font-medium"></label>
              <input type="tel" name="phone" id="enquiry-phone" required class="w-full rounded-lg border border-line bg-white px-4 py-3 text-sm focus:border-brand-red focus:outline-none" />
            </div>
          </div>
          <div>
            <label data-i18n="contactPage.emailLabel" class="mb-1.5 block text-sm font-medium"></label>
            <input type="email" name="email" id="enquiry-email" class="w-full rounded-lg border border-line bg-white px-4 py-3 text-sm focus:border-brand-red focus:outline-none" />
          </div>
          <div>
            <label data-i18n="contactPage.serviceLabel" class="mb-1.5 block text-sm font-medium"></label>
            <select name="service" id="enquiry-service" required data-i18n-options="contactPage.serviceOptions" class="w-full rounded-lg border border-line bg-white px-4 py-3 text-sm focus:border-brand-red focus:outline-none">
              <option data-idx="0">Household</option>
              <option data-idx="1">Elderly Care</option>
              <option data-idx="2">Children Care</option>
              <option data-idx="3">Specific Services</option>
            </select>
          </div>
          <div>
            <label data-i18n="contactPage.messageLabel" class="mb-1.5 block text-sm font-medium"></label>
            <textarea name="message" id="enquiry-message" rows="4" class="w-full rounded-lg border border-line bg-white px-4 py-3 text-sm focus:border-brand-red focus:outline-none"></textarea>
          </div>
          <button type="submit" data-i18n="contactPage.submit" class="btn-primary mt-2"></button>
        </form>

        <script define:vars={{ WHATSAPP_NUMBER: SITE.whatsappNumber }}>
          var enquiryForm = document.getElementById('kiarich-enquiry-form');
          if (enquiryForm) {
            enquiryForm.addEventListener('submit', function (e) {
              e.preventDefault();

              if (!enquiryForm.checkValidity()) {
                enquiryForm.reportValidity();
                return;
              }

              var name = (document.getElementById('enquiry-name') || {}).value || '';
              var phone = (document.getElementById('enquiry-phone') || {}).value || '';
              var email = (document.getElementById('enquiry-email') || {}).value || '';
              var service = (document.getElementById('enquiry-service') || {}).value || '';
              var message = (document.getElementById('enquiry-message') || {}).value || '';

              var lines = [
                '您好，我想咨询女佣服务。',
                '',
                '姓名：',
                name.trim(),
                '',
                '电话号码：',
                phone.trim(),
                '',
                '电邮：',
                email.trim(),
                '',
                '所需服务：',
                service.trim(),
                '',
                '留言：',
                message.trim(),
              ];

              var text = encodeURIComponent(lines.join('\n'));
              var url = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + text;
              window.open(url, '_blank');
            });
          }
        </script>
      </div>

      <div class="flex flex-col gap-6" data-reveal="slide-right" data-reveal-delay="120">
        <div class="card-soft p-8">
          <h3 data-i18n="contactPage.addressTitle" class="text-base font-bold uppercase tracking-wide text-brand-red sm:text-lg"></h3>
          <p class="mt-3 text-base font-medium leading-relaxed text-charcoal">
            {SITE.legalName}<br />
            {SITE.addressLine1}<br />
            {SITE.addressLine2}<br />
            {SITE.addressLine3}
          </p>
        </div>
        <div class="card-soft p-8">
          <h3 data-i18n="contactPage.phoneTitle" class="text-base font-bold uppercase tracking-wide text-brand-red sm:text-lg"></h3>
          <p class="mt-3 text-lg font-semibold text-charcoal">
            <a href={SITE.phoneHref} class="break-words transition-colors hover:text-brand-red">{SITE.phoneDisplay}</a>
          </p>
        </div>
        <div class="card-soft p-8">
          <h3 data-i18n="contactPage.whatsappTitle" class="text-base font-bold uppercase tracking-wide text-brand-red sm:text-lg"></h3>
          <p class="mt-3">
            <a
              href={SITE.whatsappHref}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 break-words text-lg font-semibold text-charcoal transition-colors hover:text-brand-red"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-5 w-5 shrink-0 fill-[#25D366]">
                <path d="M16.01 2.99C8.83 2.99 3 8.82 3 16c0 2.66.77 5.14 2.09 7.22L3 29l5.94-1.99A12.9 12.9 0 0 0 16.01 29C23.18 29 29 23.17 29 16S23.18 2.99 16.01 2.99zm0 23.6c-2.24 0-4.34-.66-6.09-1.8l-.44-.27-4.14 1.39 1.4-4.06-.29-.46A10.6 10.6 0 0 1 5.4 16c0-5.85 4.76-10.6 10.61-10.6S26.6 10.15 26.6 16 21.85 26.59 16.01 26.59zm5.86-7.97c-.32-.16-1.9-.94-2.19-1.05-.29-.11-.5-.16-.71.16-.21.32-.82 1.05-1 1.26-.19.21-.37.24-.69.08-.32-.16-1.34-.5-2.55-1.58-.94-.84-1.57-1.87-1.75-2.19-.19-.32-.02-.5.14-.66.16-.16.35-.4.53-.61.18-.21.24-.35.35-.58.11-.24.05-.42-.05-.58-.11-.16-.71-1.71-.97-2.34-.26-.61-.53-.53-.71-.53-.18 0-.42-.02-.63-.02-.21 0-.55.08-.84.4-.29.32-1.12 1.1-1.12 2.68 0 1.58 1.15 3.11 1.31 3.32.16.21 2.13 3.26 5.29 4.44 3.16 1.18 3.16.79 3.73.74.58-.05 1.9-.77 2.16-1.53.27-.74.27-1.37.19-1.5-.08-.13-.29-.21-.61-.37z"/>
              </svg>
              +{SITE.whatsappNumber}
            </a>
          </p>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-xl2 shadow-card">
          <iframe
            src="https://www.google.com/maps?q=27+Jalan+Perniagaan+Pusat+Perniagaan+Kenanga+84000+Muar+Johor&output=embed"
            class="h-full w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Kiarich Office Location"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
