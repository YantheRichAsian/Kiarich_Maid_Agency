---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';

const gallery = [
  '/images/about/InoriStudio-96.jpg',
  '/images/about/InoriStudio-109.jpg',
  '/images/about/InoriStudio-231.jpg',
  '/images/about/InoriStudio-267.jpg',
  '/images/about/InoriStudio-276.jpg',
  '/images/about/InoriStudio-318.jpg',
  '/images/about/InoriStudio-323.jpg',
  '/images/about/meetingRoom.jpg',
];
---

<BaseLayout title="About Us">
  <PageHero titleKey="about.hero" subtitleKey="about.heroSubtitle" image="/images/about/about_banner_1.jpg" />

  <section class="section-pad bg-warm-50">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div data-reveal="slide-left">
        <h2 data-i18n="about.storyTitle" class="text-2xl font-semibold sm:text-3xl"></h2>
        <p data-i18n="about.storyBody1" class="mt-5 text-base text-charcoal-soft leading-relaxed"></p>
        <p data-i18n="about.storyBody2" class="mt-4 text-base text-charcoal-soft leading-relaxed"></p>
        <p data-i18n="about.storyBody3" class="mt-4 text-base text-charcoal-soft leading-relaxed"></p>
      </div>
      <div class="grid gap-6" data-reveal-stagger>
        <div class="rounded-xl2 bg-white p-8 shadow-card">
          <h3 data-i18n="about.missionTitle" class="text-lg font-semibold text-brand-red"></h3>
          <p data-i18n="about.missionBody" class="mt-3 text-sm text-charcoal-soft leading-relaxed"></p>
        </div>
        <div class="rounded-xl2 bg-white p-8 shadow-card">
          <h3 data-i18n="about.visionTitle" class="text-lg font-semibold text-brand-red"></h3>
          <p data-i18n="about.visionBody" class="mt-3 text-sm text-charcoal-soft leading-relaxed"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-page">
      <h2 data-i18n="about.galleryTitle" class="text-center text-2xl font-semibold sm:text-3xl" data-reveal="fade-up"></h2>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4" data-reveal-stagger>
        {gallery.map((img, i) => (
          <div class:list={["overflow-hidden rounded-xl2 shadow-card", i % 3 === 0 ? "sm:row-span-2 sm:aspect-[3/4]" : "aspect-square"]}>
            <img src={img} alt="" class="h-full w-full object-cover" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
