---
import { SITE } from '../lib/site';

const stats = [
  { value: SITE.stats.years, key: 'stats.years' },
  { value: SITE.stats.maid, key: 'stats.maid' },
  { value: SITE.stats.family, key: 'stats.family' },
  { value: SITE.stats.corporate, key: 'stats.corporate' },
];
---

<section class="border-y border-line/70 bg-white">
  <div class="container-page grid grid-cols-2 gap-8 py-10 sm:grid-cols-4 sm:py-12" data-reveal-stagger>
    {stats.map((s) => (
      <div class="text-center">
        <p class="font-display text-3xl font-semibold text-brand-red sm:text-4xl">{s.value}</p>
        <p data-i18n={s.key} class="mt-1 text-xs font-medium uppercase tracking-wide text-charcoal-soft sm:text-sm"></p>
      </div>
    ))}
  </div>
</section>
