---
import { SITE, whatsappLink } from '../lib/site';

const navLinks = [
  { href: '/', key: 'nav.home' },
  { href: '/about', key: 'nav.about' },
  { href: '/services', key: 'nav.services' },
  { href: '/hiring-process', key: 'nav.process' },
  { href: '/reviews', key: 'nav.reviews' },
  { href: '/contact', key: 'nav.contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 bg-brand-red shadow-card overflow-visible">
  <div class="container-page relative flex h-20 items-center justify-between overflow-visible lg:h-24">
    <a
      href="/"
      class="hero-logo-anchor relative z-20 flex h-20 w-[10.5rem] shrink-0 items-start sm:h-[4.75rem] sm:w-[11.5rem] lg:h-24 lg:w-[14.5rem]"
    >
      <img
        src="/images/logos/logo.png"
        alt="Kiarich Maid Agency"
        class="hero-logo-img pointer-events-none absolute left-0 top-0 h-auto w-[10.5rem] sm:w-[11.5rem] lg:w-[14.5rem]"
      />
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-i18n={link.key}
          class:list={[
            'text-sm font-medium tracking-wide transition-colors hover:text-white',
            currentPath === link.href ? 'text-white underline underline-offset-8' : 'text-white/80',
          ]}
        >
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <button data-lang-toggle class="rounded-full border border-white/40 px-4 py-2 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10">中文</button>
      <a href={whatsappLink('Hello! Can I get more info on this?')} target="_blank" rel="noopener" data-i18n="nav.cta" class="nav-cta"></a>
    </div>

    <button id="mobile-menu-btn" class="relative z-10 flex h-10 w-10 flex-col items-center justify-center gap-1.5 lg:hidden" aria-label="Toggle menu" aria-expanded="false">
      <span class="mobile-bar block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="mobile-bar block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="mobile-bar block h-0.5 w-6 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <div id="mobile-menu" class="grid grid-rows-[0fr] overflow-hidden border-t border-transparent bg-brand-red transition-[grid-template-rows] duration-300 ease-out lg:hidden">
    <nav class="container-page min-h-0 overflow-hidden">
      <div class="flex flex-col gap-1 py-4">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-i18n={link.key}
            class:list={[
              'rounded-lg px-3 py-3 text-base font-medium transition-colors',
              currentPath === link.href ? 'bg-white/15 text-white' : 'text-white/85 hover:bg-white/10 hover:text-white',
            ]}
          ></a>
        ))}
        <div class="mt-3 flex items-center gap-3 px-3">
          <button data-lang-toggle class="rounded-full border border-white/40 px-4 py-2 text-sm font-semibold text-white">中文</button>
          <a href={whatsappLink('Hello! Can I get more info on this?')} target="_blank" rel="noopener" data-i18n="nav.cta" class="nav-cta flex-1"></a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  let open = false;

  function setOpen(next: boolean) {
    open = next;
    btn?.setAttribute('aria-expanded', String(open));
    if (!menu) return;
    if (open) {
      menu.classList.remove('grid-rows-[0fr]');
      menu.classList.add('grid-rows-[1fr]', 'border-line/70');
    } else {
      menu.classList.add('grid-rows-[0fr]');
      menu.classList.remove('grid-rows-[1fr]', 'border-line/70');
    }
    const bars = btn?.querySelectorAll('.mobile-bar');
    if (bars && bars.length === 3) {
      if (open) {
        bars[0].classList.add('translate-y-2', 'rotate-45');
        bars[1].classList.add('opacity-0');
        bars[2].classList.add('-translate-y-2', '-rotate-45');
      } else {
        bars[0].classList.remove('translate-y-2', 'rotate-45');
        bars[1].classList.remove('opacity-0');
        bars[2].classList.remove('-translate-y-2', '-rotate-45');
      }
    }
  }

  btn?.addEventListener('click', () => setOpen(!open));

  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
