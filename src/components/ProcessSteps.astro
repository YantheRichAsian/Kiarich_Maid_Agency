---
import en from '../i18n/en.json';
const steps = en.process.steps;
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<section class:list={["section-pad", compact ? "bg-white" : "bg-warm-50"]}>
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal="fade-up">
      <p data-i18n="process.eyebrow" class="eyebrow justify-center"></p>
      <h2 data-i18n="process.title" class="mt-3 text-3xl font-semibold sm:text-4xl"></h2>
      <p data-i18n="process.subtitle" class="mt-4 text-base text-charcoal-soft"></p>
    </div>

    <div data-i18n-list="process.steps" data-reveal-stagger class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <div class="relative rounded-xl2 bg-white p-6 shadow-card">
          <span class="font-display text-4xl font-semibold text-brand-red/20">{String(i + 1).padStart(2, '0')}</span>
          <h3 data-i18n-step-title class="mt-3 text-base font-semibold">{step.title}</h3>
          <p data-i18n-step-body class="mt-2 text-sm text-charcoal-soft leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>

    {!compact && (
      <div class="mt-12 text-center">
        <a href="/contact" data-i18n="process.cta" class="btn-primary"></a>
      </div>
    )}
  </div>
</section>
