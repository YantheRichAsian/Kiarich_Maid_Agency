---
import en from '../i18n/en.json';
const steps = en.process.steps;
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

// Linear/outline icons matching each hiring-process step.
// All icons share the same stroke style (currentColor, no fill) so they read
// consistently with the rest of the site's black-line iconography.
const stepIcons = [
  // 01 挑选女佣 — search user / user profile
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M4 19c0-2.76 2.24-5 5-5s5 2.24 5 5"/><circle cx="17.5" cy="16.5" r="2.75"/><path d="M19.6 18.6 21 20"/></svg>`,
  // 02 确认聘请 — document check / approval
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 14l1.8 1.8L15.5 11"/></svg>`,
  // 03 工作邀请 — invite candidate: person + arrow
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="7" r="3.25"/><path d="M3 19c0-2.9 2.24-5.25 5-5.25s5 2.35 5 5.25"/><path d="M15.5 9h6M19 6.5l2.5 2.5-2.5 2.5"/></svg>`,
  // 04 准备文件 — file checklist / document
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M8.5 13h.01M8.5 16.5h.01"/><path d="M11 13h4.5M11 16.5h4.5"/></svg>`,
  // 05 审批处理 — approval / government document
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 7v2h18V7z"/><path d="M5 9v9M9 9v9M15 9v9M19 9v9"/><path d="M3 20h18"/><path d="M9.5 13.5 11 15l3.5-3.5"/></svg>`,
  // 06 女佣抵达 — home arrival / travel
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 4l9 7"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/><path d="M15 4h2v2"/></svg>`,
  // 07 正式交接 — completed handover: badge-check / certificate of completion
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 15 4l3.2-.3.6 3.2 2.4 2.2-1.6 2.9 1.6 2.9-2.4 2.2-.6 3.2L15 20l-3 1.5-3-1.5-3.2.3-.6-3.2-2.4-2.2 1.6-2.9-1.6-2.9 2.4-2.2.6-3.2L9 4z"/><path d="m8.7 12.3 2.3 2.3 4.3-4.6"/></svg>`,
];
---

<section class:list={["section-pad", compact ? "bg-white" : "bg-warm-50"]}>
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal="fade-up">
      <p data-i18n="process.eyebrow" class="eyebrow justify-center"></p>
      <h2 data-i18n="process.title" class="mt-3 text-3xl font-semibold sm:text-4xl"></h2>
      <p data-i18n="process.subtitle" class="mt-4 text-base text-charcoal-soft"></p>
    </div>

    <div data-i18n-list="process.steps" data-reveal-stagger class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <div class="relative rounded-xl2 bg-white p-6 shadow-card">
          <span
            class="pointer-events-none absolute right-5 top-5 h-10 w-10 text-charcoal/70 sm:h-12 sm:w-12"
            set:html={stepIcons[i]}
          />
          <span class="font-display text-4xl font-semibold text-brand-red/20">{String(i + 1).padStart(2, '0')}</span>
          <h3 data-i18n-step-title class="mt-3 text-base font-semibold">{step.title}</h3>
          <p data-i18n-step-body class="mt-2 text-sm text-charcoal-soft leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>

    {!compact && (
      <div class="mt-12 text-center">
        <a href="/contact" data-i18n="process.cta" class="btn-primary"></a>
      </div>
    )}
  </div>
</section>
