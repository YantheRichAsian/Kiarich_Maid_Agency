---
const benefits = [
  { icon: '/images/core-businesses/professional_icon.png', titleKey: 'benefits.professional.title', bodyKey: 'benefits.professional.body' },
  { icon: '/images/core-businesses/trust_icon.png', titleKey: 'benefits.trust.title', bodyKey: 'benefits.trust.body' },
  { icon: '/images/core-businesses/ongoing_icon.png', titleKey: 'benefits.ongoing.title', bodyKey: 'benefits.ongoing.body' },
];
---

<section class="section-pad bg-warm-50">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal="fade-up">
      <p data-i18n="benefits.eyebrow" class="eyebrow justify-center"></p>
      <h2 data-i18n="benefits.title" class="mt-3 text-3xl font-semibold sm:text-4xl"></h2>
    </div>

    <div class="mt-14 grid gap-8 sm:grid-cols-3" data-reveal-stagger>
      {benefits.map((b) => (
        <div class="flex flex-col items-center gap-4 rounded-xl2 bg-white p-8 text-center shadow-card">
          <img src={b.icon} alt="" class="h-14 w-14 object-contain" />
          <h3 data-i18n={b.titleKey} class="text-lg font-semibold"></h3>
          <p data-i18n={b.bodyKey} class="text-sm text-charcoal-soft leading-relaxed"></p>
        </div>
      ))}
    </div>
  </div>
</section>
